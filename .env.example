# Jarvis Secrets — Copy this file to .env and fill in your values
# DO NOT commit the .env file

# API Server
JARVIS_API_HOST=0.0.0.0
JARVIS_API_PORT=8100

# Authentication
JARVIS_API_DEFAULT_KEY=jarvis-local-dev-key
JARVIS_JWT_SECRET=jarvis-jwt-secret-change-in-production
JARVIS_JWT_EXPIRE_SECONDS=3600

# Rate Limiting
JARVIS_RATE_LIMIT_PER_MINUTE=30
JARVIS_RATE_LIMIT_PER_HOUR=100

# Docs
JARVIS_API_ENABLE_DOCS=true
