# Virtual Environment
venv/

# Python
__pycache__/
*.pyc
*.pyo

# Logs (keep logger.py, ignore log files)
logs/*.log

# Memory sessions (keep folder structure, ignore session data)
memory/sessions/*.json

# OS
Thumbs.db
.DS_Store

# Secrets
.env

# API keys (generated, sensitive)
data/api_keys.json

# Backups
backups/

# Temp output files
out*.txt
test_output.txt

# Runtime data (keep structure, ignore generated state)
data/knowledge_memory/
data/sync/
